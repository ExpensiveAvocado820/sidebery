@import '../utils'

.TabColorsField
  position: relative
  display: flex
  flex-direction: column
  padding: 0 16px 8px
  margin-top: 3px
  &:after
    content: ''
    position: absolute
    top: -2px
    left: 6px
    width: calc(100% - 12px)
    height: 1px
    background-color: var(--toolbar-fg)
    opacity: .08

.TabColorsField .field-header
  display: flex
  align-items: center
  justify-content: space-between
  min-height: 42px
  .label
    font-size: rem(16)
    line-height: 24px
    padding: 9px 0
    color: var(--toolbar-fg)
  .add-btn
    display: flex
    align-items: center
    gap: 4px
    font-size: rem(14)
    padding: 3px 10px 3px 6px
    svg
      width: 16px
      height: 16px
      fill: var(--btn-fg)

.TabColorsField .note
  font-size: rem(13)
  color: var(--toolbar-fg)
  opacity: .6
  padding: 0 0 4px

.TabColorsField .color-list
  display: flex
  flex-direction: column
  gap: 2px

.TabColorsField .color-item
  position: relative
  display: flex
  align-items: center
  gap: 8px
  min-height: 32px
  padding: 0 4px 0 8px
  border-radius: var(--general-border-radius)
  cursor: default
  &:before
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    border-radius: inherit
    background-color: var(--toolbar-fg)
    opacity: .04
  &:hover:before
    opacity: .08
  &:active:before
    opacity: .05
  .swatch
    position: relative
    flex-shrink: 0
    width: 16px
    height: 16px
    border-radius: 50%
    background-color: var(--swatch-color)
    box-shadow: inset 0 0 0 1px #0003
  .name
    position: relative
    flex-grow: 1
    min-width: 0
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis
    font-size: rem(14)
    color: var(--toolbar-fg)
  .hex
    position: relative
    flex-shrink: 0
    font-family: monospace
    font-size: rem(12)
    color: var(--toolbar-fg)
    opacity: .6
  .ctrl-btn
    position: relative
    flex-shrink: 0
    display: flex
    align-items: center
    justify-content: center
    width: 24px
    height: 24px
    border-radius: var(--general-border-radius)
    svg
      width: 14px
      height: 14px
      fill: var(--toolbar-fg)
      opacity: .6
    &:hover svg
      opacity: 1
    &:hover
      background-color: #8882
    &.-up svg
      transform: rotateZ(180deg)
    &.-rm:hover svg
      fill: var(--status-err)
    &[data-inactive="true"]
      opacity: .3
      pointer-events: none
